# ==========================================
# Automated Resume Screening Tool - .gitignore
# ==========================================

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Packaging / Distribution
dist/
build/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Environment variables & secrets
.env
.env.*
*.env
*.pem
*.key
!.env.example

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Temporary and Cache files
*.tmp
*.temp
.cache/
.matplotlib/

# Logs
*.log
logs/

# Generated Outputs (ignore generated reports/charts, keep directory tracked)
outputs/*
!outputs/.gitkeep
